# --- 3.3. Clase de Proyectil (Bolita de Chocolate) ---
class BolitaChocolate(pygame.sprite.Sprite):
    def __init__(self, x, y, direccion):
        super().__init__()
        self.image = pygame.Surface([10, 10])
        self.image.fill((101, 67, 33)) # Color Marrón Oscuro (Chocolate)
        self.rect = self.image.get_rect()
        self.rect.center = (x, y) # Centro de la bolita
        self.velocidad = 10 * direccion # Direccion: 1 para derecha, -1 para izquierda
        
    def update(self):
        self.rect.x += self.velocidad
        # Autodestruir si sale de la pantalla (opcional)
        if self.rect.left > ANCHO or self.rect.right < 0:
            self.kill()
