# Dentro de la clase Choco:
class Choco(pygame.sprite.Sprite):
    def __init__(self):
        # ... código de inicialización anterior ...
        self.tiene_escudo = False # NUEVA VARIABLE
        # ...

    # NUEVO MÉTODO para manejar colisiones con enemigos
    def check_colision_enemigos(self, enemigos):
        colisiones_enemigos = pygame.sprite.spritecollide(self, enemigos, False)
        
        for enemigo in colisiones_enemigos:
            # Colisión con la parte superior (Aplastar)
            if self.velocidad_y > 0 and self.rect.bottom <= enemigo.rect.top + 5:
                # El jugador cae sobre el enemigo
                self.velocidad_y = self.velocidad_salto * 0.5 # Rebote
                enemigo.kill() # Eliminar enemigo
                return "APLASTADO"
            
            # Colisión lateral o inferior (Recibir daño)
            else:
                if self.tiene_escudo:
                    self.tiene_escudo = False
                    return "ESCUDO_PERDIDO"
                else:
                    return "DAÑO"
        return None

    # NUEVO MÉTODO para manejar colisiones con potenciadores
    def check_colision_potenciadores(self, potenciadores):
        colisiones_potenciadores = pygame.sprite.spritecollide(self, potenciadores, True) # 'True' elimina el potenciador
        
        for potenciador in colisiones_potenciadores:
            if isinstance(potenciador, Bombon):
                self.tiene_escudo = True
                print("¡Choco obtuvo el Bombón Protector!")
