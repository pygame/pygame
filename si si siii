# --- 2. Clase del Jugador (Choco) ---
class Choco(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        # Usamos un simple cuadrado como placeholder para Choco
        self.image = pygame.Surface([40, 60])
        self.image.fill((139, 69, 19)) # Color Chocolate
        self.rect = self.image.get_rect()
        
        # Vectores de movimiento
        self.velocidad_x = 0
        self.velocidad_y = 0
        self.en_el_suelo = False
        self.gravedad = 1.0
        self.velocidad_salto = -20 # Valor negativo para saltar hacia arriba

    def aplicar_gravedad(self):
        if not self.en_el_suelo:
            self.velocidad_y += self.gravedad
        # Limitar la velocidad de caída máxima para evitar errores
        if self.velocidad_y > 15:
            self.velocidad_y = 15

    def saltar(self):
        # Solo permitir saltar si está en el suelo
        if self.en_el_suelo:
            self.velocidad_y = self.velocidad_salto
            self.en_el_suelo = False

    def mover(self, plataformas):
        # 1. Movimiento en X
        self.rect.x += self.velocidad_x
        
        # 2. Manejo de colisiones en X (Simplificado)
        bloques_colisionados = pygame.sprite.spritecollide(self, plataformas, False)
        for bloque in bloques_colisionados:
            if self.velocidad_x > 0: # Moviéndose a la derecha
                self.rect.right = bloque.rect.left
            elif self.velocidad_x < 0: # Moviéndose a la izquierda
                self.rect.left = bloque.rect.right

        # 3. Aplicar y Mover en Y
        self.aplicar_gravedad()
        self.rect.y += self.velocidad_y
        
        # 4. Manejo de colisiones en Y
        self.en_el_suelo = False
        bloques_colisionados = pygame.sprite.spritecollide(self, plataformas, False)
        for bloque in bloques_colisionados:
            if self.velocidad_y > 0: # Cayendo
                self.rect.bottom = bloque.rect.top
                self.en_el_suelo = True
            elif self.velocidad_y < 0: # Saltando/Subiendo
                self.rect.top = bloque.rect.bottom
            self.velocidad_y = 0 # Detener el movimiento vertical después de la colisión

    def update(self, plataformas):
        self.mover(plataformas)
        
    def detener_movimiento(self):
        self.velocidad_x = 0

# --- 3. Clase de Plataforma ---
class Plataforma(pygame.sprite.Sprite):
    def __init__(self, x, y, ancho, alto):
        super().__init__()
        # Usamos un rectángulo verde como placeholder
        self.image = pygame.Surface([ancho, alto])
        self.image.fill((152, 251, 152)) # Color Merengue/Menta
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y

# --- 4. Configuración del Nivel ---
def configurar_nivel():
    plataformas_lista = pygame.sprite.Group()
    
    # Lista de coordenadas y dimensiones de plataformas: (x, y, ancho, alto)
    datos_plataformas = [
        (0, ALTO - 40, ANCHO, 40),  # Suelo
        (100, ALTO - 100, 200, 20),
        (450, ALTO - 150, 150, 20),
    ]
    
    for datos in datos_plataformas:
        plataforma = Plataforma(*datos)
        plataformas_lista.add(plataforma)
        
    return plataformas_lista

# --- 5. Bucle Principal del Juego ---
def bucle_principal():
    jugador = Choco()
    jugador.rect.x = 50
    jugador.rect.y = ALTO - 100
    
    todas_las_sprites = pygame.sprite.Group()
    todas_las_sprites.add(jugador)
    
    plataformas = configurar_nivel()
    for p in plataformas:
        todas_las_sprites.add(p)

    juego_corriendo = True
    while juego_corriendo:
        # --- Manejo de Eventos (Entrada de Usuario) ---
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                juego_corriendo = False
            
            # Movimiento y Salto
            if evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_LEFT:
                    jugador.velocidad_x = -5
                if evento.key == pygame.K_RIGHT:
                    jugador.velocidad_x = 5
                if evento.key == pygame.K_SPACE:
                    jugador.saltar()
            
            if evento.type == pygame.KEYUP:
                if evento.key == pygame.K_LEFT and jugador.velocidad_x < 0:
                    jugador.detener_movimiento()
                if evento.key == pygame.K_RIGHT and jugador.velocidad_x > 0:
                    jugador.detener_movimiento()

        # --- Actualización del Juego ---
        todas_las_sprites.update(plataformas)

        # --- Renderizado (Dibujo) ---
        PANTALLA.fill(AZUL_CIELO)
        todas_las_sprites.draw(PANTALLA)
        
        # --- Finalizar Bucle y Sincronización ---
        pygame.display.flip()
        RELOJ.tick(FPS)

    pygame.quit()

# Ejecutar el juego
if __name__ == "__main__":
    bucle_principal()
# --- 3.1. Clase del Enemigo (Marshmallow Patrullero) ---
class Marshmallow(pygame.sprite.Sprite):
    def __init__(self, x, y, limite_izq, limite_der):
        super().__init__()
        self.image = pygame.Surface([30, 30])
        self.image.fill((255, 255, 255)) # Color Blanco (Marshmallow)
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.velocidad_x = 2
        
        # Límites de patrulla
        self.limite_izq = limite_izq
        self.limite_der = limite_der
        
    def update(self):
        # Mover
        self.rect.x += self.velocidad_x
        
        # Comprobar límites y girar
        if self.rect.right >= self.limite_der or self.rect.left <= self.limite_izq:
            self.velocidad_x *= -1 # Invertir dirección
